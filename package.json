{
  "name": "minesweeper",
  "version": "1.0.0",
  "description": "Windows 7 風格 MineSweeper 桌面應用程式",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/game.test.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.minesweeper.app",
    "productName": "MineSweeper",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.games"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "7.css": "^0.21.1"
  }
}
